# Copy to .env and fill in. Without FleetGO credentials TrackLiv runs a realistic simulator.

# --- FleetGO (live vehicle positions) --------------------------------------------------------
# API key + secret are issued by FleetGO (info@fleetgo.com); username/password = a FleetGO user.
FLEETGO_CLIENT_ID=
FLEETGO_CLIENT_SECRET=
FLEETGO_USERNAME=
FLEETGO_PASSWORD=
# FLEETGO_BASE_URL=https://api.fleetgo.com
# FLEETGO_LOGIN_PATH=/api/session/login
# FLEETGO_FLEET_PATH=/api/equipment/Getfleet?groupId=0&hasDeviceOnly=false
# FLEETGO_POLL_SECONDS=30
# Add FleetGO vehicles that don't match a TrackLiv vehicle (by FleetGO id or licence plate) automatically.
# FLEETGO_AUTO_IMPORT=true

# --- Server ----------------------------------------------------------------------------------
# PORT=8787
# TZ=Europe/Berlin
# Where plans, people, projects and the audit log are stored (JSON file).
# TRACKLIV_DATA_DIR=apps/server/var
# 'demo' seeds example crew/projects/vehicles on first start, 'empty' starts blank.
# TRACKLIV_SEED=demo

# --- Simulator (only without FleetGO) --------------------------------------------------------
# SIM_SPEED=1

# --- Address search for custom destinations --------------------------------------------------
# Any Nominatim-compatible endpoint. Respect the usage policy of the public instance.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=TrackLiv/0.1 (your-email@example.com)
