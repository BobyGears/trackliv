# Copy to .env and fill in. Without FleetGO credentials TrackLiv runs a realistic simulator.

# --- FleetGO (live vehicle positions) --------------------------------------------------------
# Normal FleetGO login (the one you use on app.fleetgo.com). TrackLiv signs in to the FleetGO
# dashboard in a headless browser on the server and reads the vehicle positions from it.
# Best: a separate FleetGO user for TrackLiv, without two-factor sign-in.
# If the password contains a "$", put it in single quotes: FLEETGO_PASSWORD='pa$$word'
FLEETGO_USERNAME=
FLEETGO_PASSWORD=
# FLEETGO_POLL_SECONDS=30
# Only if the vehicles are not on the dashboard's start page (./deploy.sh --fleetgo-check tells you):
# FLEETGO_DASHBOARD_PAGE=/Map
# FLEETGO_DASHBOARD_URL=https://app.fleetgo.com
# Add FleetGO vehicles that don't match a TrackLiv vehicle (by FleetGO id or licence plate) automatically.
# FLEETGO_AUTO_IMPORT=true
#
# Alternatively the official FleetGO partner API (API keys from FleetGO, info@fleetgo.com).
# With these set, TrackLiv uses the API instead of the dashboard:
# FLEETGO_CLIENT_ID=
# FLEETGO_CLIENT_SECRET=
# FLEETGO_BASE_URL=https://api.fleetgo.com

# --- Login ----------------------------------------------------------------------------------
# Who may sign in: comma-separated "Name:password" pairs. Passwords can be plain or a scrypt hash
# from `npm run hash-password`. Without users the app is open (fine for local development only –
# the production server refuses to start without them unless TRACKLIV_AUTH=off).
# ./deploy.sh creates an "Admin" login with a random password on the first deploy.
# Don't use "$" or "," in plain passwords (Docker Compose expands "$"; "," separates users).
# TRACKLIV_USERS=Admin:change-me,Dispo 2:another-password
# 64 hex chars that sign the login cookies (./deploy.sh generates one): openssl rand -hex 32
# TRACKLIV_SESSION_SECRET=
# Switch the login off completely (demo). ./deploy.sh sets this from LOGIN in deploy/server.env.
# TRACKLIV_AUTH=off

# --- Server ----------------------------------------------------------------------------------
# PORT=8787
# TZ=Europe/Berlin
# Where plans, people, projects and the audit log are stored (JSON file).
# TRACKLIV_DATA_DIR=apps/server/var
# 'demo' seeds example crew/projects/vehicles on first start, 'empty' starts blank.
# TRACKLIV_SEED=demo

# --- Simulator (only without FleetGO) --------------------------------------------------------
# SIM_SPEED=1

# --- Address search for custom destinations --------------------------------------------------
# Any Nominatim-compatible endpoint. Respect the usage policy of the public instance.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=TrackLiv/0.1 (your-email@example.com)

# --- Web -------------------------------------------------------------------------------------
# Street map of Germany: TileJSON of an OpenMapTiles-schema vector tile source (default: OpenFreeMap,
# free, no API key). Without internet the app falls back to its built-in Rhein-Main map.
# VITE_BASEMAP_URL=https://tiles.openfreemap.org/planet
